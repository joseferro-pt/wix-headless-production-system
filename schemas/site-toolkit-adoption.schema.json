{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/whps/site-toolkit-adoption.schema.json",
  "title": "WHPS-006 website-owned toolkit adoption record v1; claims require independent evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordVersion",
    "toolkit",
    "status",
    "verification",
    "approval",
    "siteCommit"
  ],
  "properties": {
    "recordVersion": {
      "const": 1
    },
    "toolkit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit",
        "components"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/joseferro-pt/wix-headless-production-system"
        },
        "tag": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "governance",
              "validation",
              "bootstrap-cli",
              "resource-planner",
              "astro-reference",
              "site-qa"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "candidate-unverified",
        "adopted-owner-recorded"
      ]
    },
    "verification": {
      "enum": [
        "required-live-github-check",
        "operator-checked-github"
      ]
    },
    "approval": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "siteCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "adopted-owner-recorded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "const": "operator-checked-github"
          },
          "approval": {
            "const": "approved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "candidate-unverified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "const": "required-live-github-check"
          },
          "approval": {
            "const": "pending"
          }
        }
      }
    }
  ]
}
